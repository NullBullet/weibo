<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jun.mapper.TestMapper">
    <insert id="insertBatchSomeColumn">
        INSERT INTO user_statistics (
        user_id,
        following_count,
        followers_count,
        statuses_count,
        likes_count,
        updated_at
        )
        VALUES
        <!--
             collection="list": 对应 @Param("list")
             item="item": 循环中的每一个对象
             separator=",": 每个括号之间用逗号分隔
        -->
        <foreach collection="statsListToSave" item="item" separator=",">
            (
            #{item.userId},
            #{item.followingCount},
            #{item.followersCount},
            #{item.statusesCount},
            #{item.likesCount},
            #{item.updatedAt}
            )
        </foreach>
    </insert>
</mapper>
