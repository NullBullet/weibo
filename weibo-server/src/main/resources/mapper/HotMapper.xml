<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jun.mapper.HotMapper">
    <select id="getTopics" resultType="com.jun.vo.HotTopicVO">
        select `rank`, title, heat_value heat FROM hot_topics
        ORDER BY `rank`
        <if test="size != null">
            LIMIT #{size}
        </if>
    </select>
    <select id="getUsersInfoByUserIds" resultType="com.jun.vo.UserVO">
        select id,nickname,avatar from users where id in
            <foreach collection="setIds" separator="," open="(" close=")" item="id">
                #{id}
            </foreach>
    </select>
    <select id="getImageByIds" resultType="com.jun.entity.StatusImage">
        select *from status_images where status_id in
        <foreach collection="ids" item="image" open="(" close=")" separator=",">
            #{image}
        </foreach>
    </select>
    <select id="getPostByMissIds" resultType="com.jun.vo.HotStatusVO">
        select *from statuses where id in
        <foreach collection="missIds" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
        and is_deleted = 0
    </select>
    <select id="getPostByIds" resultType="com.jun.vo.HotStatusVO">
        select s.*,u.id as "user.id",u.nickname as "user.nickname", u.avatar as "user.avatar"
        from statuses s left join users u on s.user_id = u.id
        where s.id in
        <foreach collection="originalIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        and s.is_deleted = 0
    </select>
</mapper>
