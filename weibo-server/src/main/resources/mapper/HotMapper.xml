<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jun.weiboserver.mapper.HotMapper">
    <select id="getTopics" resultType="com.jun.vo.HotTopicVO">
        select `rank`, title, heat_value heat FROM hot_topics
        ORDER BY `rank`
        <if test="size != null">
            LIMIT #{size}
        </if>
    </select>
    <select id="getUsersInfoByUserIds" resultType="com.jun.vo.UserVO">
        select id,nickname name ,avatar from users where id in
            <foreach collection="ids" separator="," open="(" close=")" item="id">
                #{id}
            </foreach>
    </select>
    <select id="getImageByIds" resultType="com.jun.entity.StatusImage">
        select *from status_images where status_id in
        <foreach collection="ids" item="image" open="(" close=")" separator=",">
            #{image}
        </foreach>
    </select>
</mapper>
