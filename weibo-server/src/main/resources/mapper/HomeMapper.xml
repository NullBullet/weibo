<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jun.mapper.HomeMapper">


    <select id="getPosts" resultType="com.jun.vo.HomeStatusVO">
        select * from statuses
        <where>
            <if test="query.keyword !=null and query.keyword!=''">and content like concat("%",#{query.keyword},"%") </if>
            <if test="query.startDate !=null and query.endDate!=null">and created_at between #{query.startDate} and #{query.endDate}</if>
            <if test="followingIds!= null and followingIds.size() > 0"> and user_id in
                <foreach collection="followingIds" item="id" open="(" close=")" separator=",">
                    #{id}
                </foreach>
            </if>
        </where>
        order by created_at desc
    </select>

    <select id="getUsersInfoByUserIds" resultType="com.jun.vo.UserVO">
        select id,nickname name ,avatar from users where id in
        <foreach collection="setIds" separator="," open="(" close=")" item="id">
            #{id}
        </foreach>
    </select>
    <select id="getImageByIds" resultType="com.jun.entity.StatusImage">
        select *from status_images where status_id in
        <foreach collection="statusIds" item="image" open="(" close=")" separator=",">
            #{image}
        </foreach>
    </select>
</mapper>
