<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jun.mapper.SearchMapper">

    <select id="getResults" resultType="com.jun.vo.HotStatusVO">
        select * from statuses
        <where>
            <if test="q!=null and q!=''">and content like concat("%",#{q},"%")</if>
            <if test="startDate!=null and endDate!=null">and created_at between #{startDate} and #{endDate}</if>
        </where>
        order by created_at desc
    </select>

    <select id="getUsersInfoByUserIds" resultType="com.jun.vo.UserVO">
        select id,nickname,avatar from users where id in
        <foreach collection="setIds" separator="," open="(" close=")" item="id">
            #{id}
        </foreach>
    </select>
    <select id="getImageByIds" resultType="com.jun.entity.StatusImage">
        select *from status_images where status_id in
        <foreach collection="statusIds" item="image" open="(" close=")" separator=",">
            #{image}
        </foreach>
    </select>
    <select id="getUsers" resultType="com.jun.vo.SearchUserVO">
        select id, nickname,avatar,bio from users
        <where>
            <if test="q!=null and q!=''">and nickname like concat("%",#{q},"%")</if>
        </where>
        order by created_at desc
    </select>
    <select id="getResultIds" resultType="java.lang.Long">
        select id from statuses
        <where>
            <if test="q!=null and q!=''">and content like concat("%",#{q},"%")</if>
            <if test="startDate!=null and endDate!=null">and created_at between #{startDate} and #{endDate}</if>
        </where>
        order by created_at desc limit #{page},#{pageSize}
    </select>
    <select id="getPostByIds" resultType="com.jun.vo.SearchStatusVO">
        select * from statuses where id in
            <foreach collection="missIds" item="id" open="(" close=")" separator=",">
                #{id}
            </foreach>
    </select>
    <select id="countResults" resultType="java.lang.Long">
        select count(0) from statuses
        <where>
            <if test="keyword!=null and keyword!=''">and content like concat("%",#{keyword},"%")</if>
        </where>
    </select>
    <select id="countResultsByTime" resultType="java.lang.Long">
        select count(0) from statuses
        <where>
            <if test="keyword!=null and keyword!=''">and content like concat("%",#{keyword},"%")</if>
            <if test="startDate!=null and endDate!= null">and created_at between #{startDate} and #{endDate}</if>
        </where>
    </select>
    <select id="getComprehensiveResultIds" resultType="java.lang.Long">
        select id from statuses
        <where>
            <if test="keyword!=null and keyword!=''">and content like concat("%",#{keyword},"%")</if>
            <if test="startDate!=null and endDate!= null">and created_at between #{startDate} and #{endDate}</if>
        </where>
    </select>
</mapper>
