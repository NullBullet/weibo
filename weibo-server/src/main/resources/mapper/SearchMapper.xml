<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jun.mapper.SearchMapper">

    <select id="getResults" resultType="com.jun.vo.HotStatusVO">
        select * from statuses
        <where>
            <if test="q!=null and q!=''">and content like concat("%",#{q},"%")</if>
            <if test="startDate!=null and endDate!=null">and created_at between #{startDate} and #{endDate}</if>
        </where>
        order by created_at desc
    </select>

    <select id="getUsersInfoByUserIds" resultType="com.jun.vo.UserVO">
        select id,nickname,avatar from users where id in
        <foreach collection="setIds" separator="," open="(" close=")" item="id">
            #{id}
        </foreach>
    </select>
    <select id="getImageByIds" resultType="com.jun.entity.StatusImage">
        select *from status_images where status_id in
        <foreach collection="statusIds" item="image" open="(" close=")" separator=",">
            #{image}
        </foreach>
    </select>
</mapper>
