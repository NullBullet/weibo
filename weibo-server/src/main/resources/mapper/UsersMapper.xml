<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.jun.mapper.UsersMapper">

    <update id="updateProfile">
        update users
        <set>
            <if test="dto.nickname!=null and dto.nickname!=''">nickname =#{dto.nickname},</if>
            <if test="dto.bio!=null and dto.bio!=''">bio =#{dto.bio},</if>
            <if test="dto.gender!=null">gender =#{dto.gender},</if>
            <if test="dto.birthday!=null">birthday =#{dto.birthday},</if>
            <if test="dto.relationshipStatus!=null">relationship_status =#{dto.relationshipStatus},</if>
            <if test="dto.hometown!=null and dto.hometown!=''">hometown =#{dto.hometown},</if>
            <if test="dto.avatar!=null and dto.avatar!=''">avatar =#{dto.avatar},</if>
        </set>
        where id = #{userId}
    </update>
    <select id="getPostByUserId" resultType="com.jun.vo.StatusVO">
        select *from statuses
                <where>
                    <if test="q != null and q!=''">and content like concat("%",#{q},"%")</if>
                    <if test="userId!=null">and user_id = #{userId}</if>
                </where>
        order by created_at desc
    </select>
    <select id="getImageByIds" resultType="com.jun.entity.StatusImage" >
        select *from status_images where status_id in
            <foreach collection="ids" item="image" open="(" close=")" separator=",">
                #{image}
            </foreach>
    </select>
</mapper>
